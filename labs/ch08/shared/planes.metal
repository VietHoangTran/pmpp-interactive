// Provided for lab 8.1 (you do not edit this file): the thread-coarsened stencil of
// book Fig. 8.10 (p. 194) in Metal Shading Language. Same algorithm and the same
// differences from the page as shared/planes.cu (c3 with y-1, c4 with y+1, as in
// Figs. 8.6 and 8.8). The harness defines TILE_WIDTH when it compiles this file.
//
// All position attributes are uint3: MSL requires every position attribute of a
// kernel to have the same number of components (notes/today/ch08-facts.md C2).
#include <metal_stdlib>
using namespace metal;

// Same layout as lab1_stencil3d/stencil.h.
struct StencilCoeffs { float c0, c1, c2, c3, c4, c5, c6; };

#ifndef TILE_WIDTH
#define TILE_WIDTH 32
#endif
#define PLANES_IN_TILE_DIM TILE_WIDTH
#define PLANES_OUT_TILE_DIM (PLANES_IN_TILE_DIM - 2)

kernel void stencil_planes(device const float*    in [[buffer(0)]],
                           device float*         out [[buffer(1)]],
                           constant uint&          N [[buffer(2)]],
                           constant StencilCoeffs& c [[buffer(3)]],
                           uint3 tid [[thread_position_in_threadgroup]],
                           uint3 bid [[threadgroup_position_in_grid]]) {
    int iStart = int(bid.z * PLANES_OUT_TILE_DIM);
    int j = int(bid.y * PLANES_OUT_TILE_DIM + tid.y) - 1;
    int k = int(bid.x * PLANES_OUT_TILE_DIM + tid.x) - 1;
    int n = int(N);
    threadgroup float inPrev_s[PLANES_IN_TILE_DIM][PLANES_IN_TILE_DIM];
    threadgroup float inCurr_s[PLANES_IN_TILE_DIM][PLANES_IN_TILE_DIM];
    threadgroup float inNext_s[PLANES_IN_TILE_DIM][PLANES_IN_TILE_DIM];
    if (iStart - 1 >= 0 && iStart - 1 < n && j >= 0 && j < n && k >= 0 && k < n) {
        inPrev_s[tid.y][tid.x] = in[(iStart - 1) * n * n + j * n + k];
    }
    if (iStart >= 0 && iStart < n && j >= 0 && j < n && k >= 0 && k < n) {
        inCurr_s[tid.y][tid.x] = in[iStart * n * n + j * n + k];
    }
    for (int i = iStart; i < iStart + PLANES_OUT_TILE_DIM; ++i) {
        if (i + 1 >= 0 && i + 1 < n && j >= 0 && j < n && k >= 0 && k < n) {
            inNext_s[tid.y][tid.x] = in[(i + 1) * n * n + j * n + k];
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (i >= 1 && i < n - 1 && j >= 1 && j < n - 1 && k >= 1 && k < n - 1) {
            if (tid.y >= 1 && tid.y < PLANES_IN_TILE_DIM - 1 && tid.x >= 1 && tid.x < PLANES_IN_TILE_DIM - 1) {
                out[i * n * n + j * n + k] = c.c0 * inCurr_s[tid.y][tid.x]
                                           + c.c1 * inCurr_s[tid.y][tid.x - 1]
                                           + c.c2 * inCurr_s[tid.y][tid.x + 1]
                                           + c.c3 * inCurr_s[tid.y - 1][tid.x]
                                           + c.c4 * inCurr_s[tid.y + 1][tid.x]
                                           + c.c5 * inPrev_s[tid.y][tid.x]
                                           + c.c6 * inNext_s[tid.y][tid.x];
            }
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        inPrev_s[tid.y][tid.x] = inCurr_s[tid.y][tid.x];
        inCurr_s[tid.y][tid.x] = inNext_s[tid.y][tid.x];
    }
}
