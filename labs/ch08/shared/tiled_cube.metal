// Provided for lab 8.1 (you do not edit this file): the shared-memory tiled stencil
// of book Fig. 8.8 (p. 191) in Metal Shading Language. Same algorithm and the same
// differences from the page as shared/tiled_cube.cu: an 8 x 8 x 8 threadgroup, the
// inner 6 x 6 x 6 threads compute.
#include <metal_stdlib>
using namespace metal;

// Same layout as lab1_stencil3d/stencil.h.
struct StencilCoeffs { float c0, c1, c2, c3, c4, c5, c6; };

#define CUBE_IN_TILE_DIM 8
#define CUBE_OUT_TILE_DIM (CUBE_IN_TILE_DIM - 2)

kernel void stencil_tiled_cube(device const float*    in [[buffer(0)]],
                               device float*         out [[buffer(1)]],
                               constant uint&          N [[buffer(2)]],
                               constant StencilCoeffs& c [[buffer(3)]],
                               uint3 tid [[thread_position_in_threadgroup]],
                               uint3 bid [[threadgroup_position_in_grid]]) {
    int i = int(bid.z * CUBE_OUT_TILE_DIM + tid.z) - 1;
    int j = int(bid.y * CUBE_OUT_TILE_DIM + tid.y) - 1;
    int k = int(bid.x * CUBE_OUT_TILE_DIM + tid.x) - 1;
    int n = int(N);
    threadgroup float in_s[CUBE_IN_TILE_DIM][CUBE_IN_TILE_DIM][CUBE_IN_TILE_DIM];
    if (i >= 0 && i < n && j >= 0 && j < n && k >= 0 && k < n) {
        in_s[tid.z][tid.y][tid.x] = in[i * n * n + j * n + k];
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (i >= 1 && i < n - 1 && j >= 1 && j < n - 1 && k >= 1 && k < n - 1) {
        if (tid.z >= 1 && tid.z < CUBE_IN_TILE_DIM - 1 &&
            tid.y >= 1 && tid.y < CUBE_IN_TILE_DIM - 1 &&
            tid.x >= 1 && tid.x < CUBE_IN_TILE_DIM - 1) {
            out[i * n * n + j * n + k] = c.c0 * in_s[tid.z][tid.y][tid.x]
                                       + c.c1 * in_s[tid.z][tid.y][tid.x - 1]
                                       + c.c2 * in_s[tid.z][tid.y][tid.x + 1]
                                       + c.c3 * in_s[tid.z][tid.y - 1][tid.x]
                                       + c.c4 * in_s[tid.z][tid.y + 1][tid.x]
                                       + c.c5 * in_s[tid.z - 1][tid.y][tid.x]
                                       + c.c6 * in_s[tid.z + 1][tid.y][tid.x];
        }
    }
}
