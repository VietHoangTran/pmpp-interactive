// Provided for lab 12.3. You do not edit this file (Metal Shading Language).
// The Metal side of scan_u32.cu: the same three-kernel exclusive scan of 32-bit unsigned
// integers (scan-scan-add, section 11.9, Fig. 11.14, pp. 273-274), plus the copy reference.
// scan_u32_launch.mm encodes them.
//
// Several dispatches in one serial compute encoder run in order and see each other's writes
// (notes/today/ch02-facts.md C9), which is the only ordering this scan needs: no threadgroup
// waits for another inside a dispatch (Apple documents no forward progress between
// threadgroups, notes/today/ch12-facts.md C4).
//
// Inside a threadgroup: a coalesced load of the tile into threadgroup memory, a sequential
// scan of each thread's SCAN_ITEMS consecutive elements, then the thread totals are scanned
// with simd_prefix_exclusive_sum inside each SIMD-group and a scan of the SIMD-group totals
// (notes/today/ch11-facts.md C1, C2). The totals array has one slot per thread, enough for
// the narrowest possible SIMD-group, so no width is assumed.
#include <metal_stdlib>
using namespace metal;

#define SCAN_BLOCK_DIM 256
#define SCAN_ITEMS 4
#define SCAN_TILE (SCAN_BLOCK_DIM * SCAN_ITEMS)

kernel void scan_tiles_u32(device const uint* in         [[buffer(0)]],
                           device uint*       out        [[buffer(1)]],
                           device uint*       tileTotals [[buffer(2)]],
                           constant uint&     n          [[buffer(3)]],
                           constant uint&     wantTotals [[buffer(4)]],
                           uint t      [[thread_position_in_threadgroup]],
                           uint tile   [[threadgroup_position_in_grid]],
                           uint lane   [[thread_index_in_simdgroup]],
                           uint sg     [[simdgroup_index_in_threadgroup]]) {
    threadgroup uint tile_s[SCAN_TILE];
    threadgroup uint groupTotals[SCAN_BLOCK_DIM];

    const uint base = tile * SCAN_TILE;
    for (uint c = 0; c < SCAN_ITEMS; ++c) {
        const uint i = base + c * SCAN_BLOCK_DIM + t;
        tile_s[c * SCAN_BLOCK_DIM + t] = i < n ? in[i] : 0u;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);   // whole tile loaded: in == out is safe

    uint local[SCAN_ITEMS];
    uint threadSum = 0;
    for (uint c = 0; c < SCAN_ITEMS; ++c) {
        local[c] = threadSum;
        threadSum += tile_s[t * SCAN_ITEMS + c];
    }

    // Every thread calls the SIMD-group functions (uniform control flow).
    const uint beforeInGroup = simd_prefix_exclusive_sum(threadSum);
    const uint groupTotal = simd_sum(threadSum);
    if (lane == 0) {
        groupTotals[sg] = groupTotal;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    uint beforeGroup = 0;
    for (uint g = 0; g < sg; ++g) {
        beforeGroup += groupTotals[g];
    }
    const uint before = beforeGroup + beforeInGroup;

    for (uint c = 0; c < SCAN_ITEMS; ++c) {
        tile_s[t * SCAN_ITEMS + c] = local[c] + before;
    }
    if (wantTotals != 0 && t == SCAN_BLOCK_DIM - 1) {
        tileTotals[tile] = before + threadSum;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    for (uint c = 0; c < SCAN_ITEMS; ++c) {
        const uint i = base + c * SCAN_BLOCK_DIM + t;
        if (i < n) {
            out[i] = tile_s[c * SCAN_BLOCK_DIM + t];
        }
    }
}

kernel void add_tile_offsets_u32(device uint*       out         [[buffer(0)]],
                                 device const uint* tileOffsets [[buffer(1)]],
                                 constant uint&     n           [[buffer(2)]],
                                 uint t    [[thread_position_in_threadgroup]],
                                 uint tile [[threadgroup_position_in_grid]]) {
    const uint add = tileOffsets[tile];
    const uint base = tile * SCAN_TILE;
    for (uint c = 0; c < SCAN_ITEMS; ++c) {
        const uint i = base + c * SCAN_BLOCK_DIM + t;
        if (i < n) {
            out[i] += add;
        }
    }
}

kernel void copy_u32(device const uint* in  [[buffer(0)]],
                     device uint*       out [[buffer(1)]],
                     constant uint&     n   [[buffer(2)]],
                     uint i [[thread_position_in_grid]]) {
    if (i < n) {
        out[i] = in[i];
    }
}
