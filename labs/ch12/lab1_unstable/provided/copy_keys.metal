#include <metal_stdlib>
using namespace metal;

// region: copy
kernel void copy_keys(device const uint* input  [[buffer(0)]],
                      device uint*       output [[buffer(1)]],
                      constant uint&     n      [[buffer(2)]],
                      uint i [[thread_position_in_grid]]) {
    if (i < n) {
        output[i] = input[i];
    }
}
// endregion
