// Provided for labs 14.1 and 14.2. You do not edit this file (Metal Shading Language). Ours.
// The Metal twin of scan.cu: the same in-place, three-kernel exclusive scan of unsigned ints
// (scan-scan-add, section 11.9, Fig. 11.14, pp. 273-274). scan_launch.mm encodes it.
//
// Several dispatches in one serial compute encoder run in order and each sees the previous
// one's writes (notes/today/ch02-facts.md C9). That is the only ordering this scan needs: no
// threadgroup ever waits for another inside a dispatch, and Apple documents no forward progress
// between threadgroups (notes/today/ch14-facts.md C4).
//
// Inside a threadgroup: a coalesced load of the tile into threadgroup memory, a sequential scan
// of each thread's SCAN_ITEMS consecutive elements, then the thread totals are scanned with
// simd_prefix_exclusive_sum inside each SIMD-group and a sum of the SIMD-group totals before it
// (notes/today/infra-facts.md C2). The SIMD-group totals array has one slot per thread, which
// is enough for the narrowest possible SIMD-group, so no width is assumed.
//
// How a threadgroup is split into SIMD-groups is implementation-defined (MSL 5.2.3.6,
// notes/today/ch04-facts.md C2), so thread_position_in_threadgroup need not follow the scan's
// order. The scan adds up thread totals in (SIMD-group, lane) order, so the positions a thread
// owns in that phase come from its rank in that order, me = sg * width + lane. The coalesced
// load and store may use any one-to-one assignment and keep t.
#include <metal_stdlib>
using namespace metal;

#define SCAN_BLOCK_DIM 256
#define SCAN_ITEMS 4
#define SCAN_TILE (SCAN_BLOCK_DIM * SCAN_ITEMS)

kernel void scan_tile(device uint*   data       [[buffer(0)]],
                      device uint*   tileTotals [[buffer(1)]],
                      constant uint& count      [[buffer(2)]],
                      constant uint& wantTotals [[buffer(3)]],
                      uint t     [[thread_position_in_threadgroup]],
                      uint tile  [[threadgroup_position_in_grid]],
                      uint lane  [[thread_index_in_simdgroup]],
                      uint sg    [[simdgroup_index_in_threadgroup]],
                      uint numSg [[simdgroups_per_threadgroup]],
                      uint width [[threads_per_simdgroup]]) {
    threadgroup uint tile_s[SCAN_TILE];
    threadgroup uint sgTotals[SCAN_BLOCK_DIM];

    const uint base = tile * SCAN_TILE;
    const uint me = sg * width + lane;   // this thread's rank in the scan's order
    for (uint k = 0; k < SCAN_ITEMS; ++k) {
        const uint i = base + k * SCAN_BLOCK_DIM + t;
        tile_s[k * SCAN_BLOCK_DIM + t] = i < count ? data[i] : 0u;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    uint mine[SCAN_ITEMS];
    uint threadTotal = 0;
    for (uint k = 0; k < SCAN_ITEMS; ++k) {
        mine[k] = threadTotal;
        threadTotal += tile_s[me * SCAN_ITEMS + k];
    }

    // Every thread calls the SIMD-group functions (uniform control flow).
    const uint beforeInGroup = simd_prefix_exclusive_sum(threadTotal);
    const uint groupTotal = simd_sum(threadTotal);
    if (lane == 0) {
        sgTotals[sg] = groupTotal;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    uint beforeGroup = 0;
    for (uint g = 0; g < sg; ++g) {
        beforeGroup += sgTotals[g];
    }
    const uint before = beforeGroup + beforeInGroup;

    for (uint k = 0; k < SCAN_ITEMS; ++k) {
        tile_s[me * SCAN_ITEMS + k] = mine[k] + before;
    }
    if (wantTotals != 0 && t == SCAN_BLOCK_DIM - 1) {
        uint all = 0;
        for (uint g = 0; g < numSg; ++g) {
            all += sgTotals[g];
        }
        tileTotals[tile] = all;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    for (uint k = 0; k < SCAN_ITEMS; ++k) {
        const uint i = base + k * SCAN_BLOCK_DIM + t;
        if (i < count) {
            data[i] = tile_s[k * SCAN_BLOCK_DIM + t];
        }
    }
}

kernel void add_tile_offsets(device uint*       data        [[buffer(0)]],
                             device const uint* tileOffsets [[buffer(1)]],
                             constant uint&     count       [[buffer(2)]],
                             uint t    [[thread_position_in_threadgroup]],
                             uint tile [[threadgroup_position_in_grid]]) {
    const uint add = tileOffsets[tile];
    const uint base = tile * SCAN_TILE;
    for (uint k = 0; k < SCAN_ITEMS; ++k) {
        const uint i = base + k * SCAN_BLOCK_DIM + t;
        if (i < count) {
            data[i] += add;
        }
    }
}
