// Provided for lab 14.2 as its benchmark baseline. You do not edit this file (Metal Shading
// Language). It is lab 14.1's part B in Metal: do lab 14.1 first.
// One bit per pass, every key written straight to its global destination (section 14.5,
// Figs. 14.6 and 14.7, pp. 336-339). onebit_global_launch.mm encodes it.
#include <metal_stdlib>
using namespace metal;

kernel void onebit_global_extract(device const uint* keys [[buffer(0)]],
                                  device uint*       bits [[buffer(1)]],
                                  constant uint&     n    [[buffer(2)]],
                                  constant uint&     bit  [[buffer(3)]],
                                  uint i [[thread_position_in_grid]]) {
    if (i < n) {
        bits[i] = (keys[i] >> bit) & 1u;
    } else if (i == n) {
        bits[n] = 0u;
    }
}

kernel void onebit_global_scatter(device const uint* keysIn     [[buffer(0)]],
                                  device const uint* valsIn     [[buffer(1)]],
                                  device uint*       keysOut    [[buffer(2)]],
                                  device uint*       valsOut    [[buffer(3)]],
                                  device const uint* onesBefore [[buffer(4)]],
                                  constant uint&     n          [[buffer(5)]],
                                  constant uint&     bit        [[buffer(6)]],
                                  uint i [[thread_position_in_grid]]) {
    if (i < n) {
        const uint key = keysIn[i];
        const uint b = (key >> bit) & 1u;
        const uint before = onesBefore[i];
        const uint total = onesBefore[n];
        const uint dst = b == 0 ? i - before : n - total + before;
        keysOut[dst] = key;
        valsOut[dst] = valsIn[i];
    }
}
