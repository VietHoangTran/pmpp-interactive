// Lab 18.1, provided (you do not edit this file): the Metal forms of the kernels in
// ref_kernels.cu. ref_bfs_push is book Fig. 18.6 with relaxed atomics in place of the benign
// race; ref_bfs_frontier is Figs. 18.12 and 18.14; bfs_floor is empty.
//
// In Metal every one of these accesses is atomic by necessity: atomic functions take atomic
// types only (notes/today/infra-facts.md C1), so level[] is `device atomic_uint*` and every
// read and write of it goes through atomic_load_explicit, atomic_store_explicit or a
// compare-and-exchange. MSL has only the weak compare-and-exchange (ch18-facts C4), hence the
// retry loop in ref_visit_vertex.
#include <metal_stdlib>
using namespace metal;

constant uint UNVISITED = numeric_limits<uint>::max();

// Fig. 18.14: true for exactly one of the threads that try to visit the same vertex. A weak
// compare-and-exchange may fail although the values were equal; then `expected` still holds
// UNVISITED and the loop tries again. A real failure loads the winner's level into `expected`.
static bool ref_visit_vertex(device atomic_uint* level, uint vertex, uint currLevel) {
    uint expected = UNVISITED;
    while (!atomic_compare_exchange_weak_explicit(&level[vertex], &expected, currLevel,
                                                  memory_order_relaxed, memory_order_relaxed)) {
        if (expected != UNVISITED) {
            return false;
        }
    }
    return true;
}

// region: push
kernel void ref_bfs_push(device const uint*  srcPtrs          [[buffer(0)]],
                         device const uint*  dst              [[buffer(1)]],
                         constant uint&      numVertices      [[buffer(2)]],
                         device atomic_uint* level            [[buffer(3)]],
                         device atomic_uint* newVertexVisited [[buffer(4)]],
                         constant uint&      currLevel        [[buffer(5)]],
                         uint vertex [[thread_position_in_grid]]) {
    if (vertex < numVertices) {
        if (atomic_load_explicit(&level[vertex], memory_order_relaxed) == currLevel - 1) {
            for (uint edge = srcPtrs[vertex]; edge < srcPtrs[vertex + 1]; ++edge) {
                uint neighbor = dst[edge];
                if (atomic_load_explicit(&level[neighbor], memory_order_relaxed) == UNVISITED) {
                    atomic_store_explicit(&level[neighbor], currLevel, memory_order_relaxed);
                    atomic_store_explicit(newVertexVisited, 1u, memory_order_relaxed);
                }
            }
        }
    }
}
// endregion

// region: frontier
kernel void ref_bfs_frontier(device const uint*  srcPtrs         [[buffer(0)]],
                             device const uint*  dst             [[buffer(1)]],
                             device atomic_uint* level           [[buffer(2)]],
                             device const uint*  prevFrontier    [[buffer(3)]],
                             device uint*        currFrontier    [[buffer(4)]],
                             constant uint&      numPrevFrontier [[buffer(5)]],
                             device atomic_uint* numCurrFrontier [[buffer(6)]],
                             constant uint&      currLevel       [[buffer(7)]],
                             uint i [[thread_position_in_grid]]) {
    if (i < numPrevFrontier) {
        uint vertex = prevFrontier[i];
        for (uint edge = srcPtrs[vertex]; edge < srcPtrs[vertex + 1]; ++edge) {
            uint neighbor = dst[edge];
            if (ref_visit_vertex(level, neighbor, currLevel)) {
                uint currFrontierIdx = atomic_fetch_add_explicit(numCurrFrontier, 1u, memory_order_relaxed);
                currFrontier[currFrontierIdx] = neighbor;
            }
        }
    }
}
// endregion

kernel void bfs_floor() {
