// Lab 19.1, provided (Metal Shading Language). You do not edit this file.
// The corrected Fig. 19.11, line for line as in provided/implicit_gemm.cu: ceiling phase
// count, bounds checks with zero fill on the F load, the X gather and the store.
//
// CUDA                         Metal
// __shared__ float a[..]       threadgroup float a[..]
// __syncthreads()              threadgroup_barrier(mem_flags::mem_threadgroup)
// blockIdx.z (the sample)      [[threadgroup_position_in_grid]].z
//
// The divides of Eq. 19.5 have run-time denominators here (K, W_out). Apple's only
// statement on their cost is a 2016 talk (ch19-facts C6); this file keeps the book's
// arithmetic so the three paths are compared as written.
#include <metal_stdlib>
using namespace metal;

#ifndef TILE_WIDTH
#define TILE_WIDTH 16
#endif

struct ImplicitGemmDims { int C; int H; int W; int M; int K; };   // must match implicit_gemm_launch.mm

kernel void conv_implicit_gemm(device const float* X [[buffer(0)]],
                               device const float* F [[buffer(1)]],
                               device float*       Y [[buffer(2)]],
                               constant ImplicitGemmDims& d [[buffer(3)]],
                               uint3 tid [[thread_position_in_threadgroup]],
                               uint3 bid [[threadgroup_position_in_grid]]) {
    threadgroup float Fds[TILE_WIDTH][TILE_WIDTH];
    threadgroup float Bds[TILE_WIDTH][TILE_WIDTH];

    int tx = int(tid.x), ty = int(tid.y);
    int bz = int(bid.z);   // the sample n

    int C = d.C, H = d.H, W = d.W, M = d.M, K = d.K;
    int H_out = H - K + 1, W_out = W - K + 1;
    int P = H_out * W_out;
    int CKK = C * K * K;

    int Row = int(bid.y) * TILE_WIDTH + ty;   // output map
    int Col = int(bid.x) * TILE_WIDTH + tx;   // output pixel

    float Pvalue = 0;
    for (int ph = 0; ph < (CKK + TILE_WIDTH - 1) / TILE_WIDTH; ++ph) {
        int fc = ph * TILE_WIDTH + tx;
        Fds[ty][tx] = (Row < M && fc < CKK) ? F[Row * CKK + fc] : 0.0f;

        int u = ph * TILE_WIDTH + ty;
        int v = Col;
        if (u < CKK && v < P) {
            Bds[ty][tx] = X[bz * (C * H * W) + (u / (K * K)) * (H * W)
                            + ((u % (K * K)) / K + v / W_out) * W
                            + ((u % (K * K)) % K + v % W_out)];
        } else {
            Bds[ty][tx] = 0.0f;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);

        for (int k = 0; k < TILE_WIDTH; ++k) {
            Pvalue += Fds[ty][k] * Bds[k][tx];
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    if (Row < M && Col < P) {
        Y[bz * M * P + Row * P + Col] = Pvalue;
    }
}
